# Docling-serve URL
DOCLING_URL=http://docling:5001/v1/convert/file

# Gotenberg (DOCX→PDF конвертация)
GOTENBERG_URL=http://10.121.3.201:3004

# VLM defaults (перекрываются настройками из OpenWebUI)
DEFAULT_VLM_URL=http://10.121.3.201:4000/v1/chat/completions
DEFAULT_VLM_API_KEY=your_litellm_api_key_here
DEFAULT_VLM_MODEL=Qwen3.5-122B-agent-50k
DEFAULT_VLM_TIMEOUT=300
DEFAULT_VLM_CONCURRENCY=14
DEFAULT_VLM_MAX_CONCURRENT_DOCS=2
DEFAULT_VLM_MAX_COMPLETION_TOKENS=8192

# Маршрутизация и разрешение рендеринга (override per-request через form-data)
# Порог страниц TEXT PDF: ≤порога → VLM full-page, >порога → standard+picture_description.
# Per-request override: form-field "vlm_page_threshold".
TEXT_PDF_VLM_PAGE_THRESHOLD=20
# scale для build_vlm_pipeline_model_api и build_custom_model.
# Per-request override: form-field "vlm_scale".
DEFAULT_VLM_SCALE=1.5
# images_scale для standard-пайплайна — единственный параметр, реально влияющий
# на разрешение картинок в picture_description_api. Linear: 1.0 ≈ 36 DPI,
# 2.0 ≈ 100 DPI, 3.0 ≈ 150 DPI для A4. Per-request override: form-field "images_scale".
DEFAULT_IMAGES_SCALE=2.0
