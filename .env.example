# Docling-serve URL
DOCLING_URL=http://docling:5001/v1/convert/file

# Gotenberg (DOCX→PDF конвертация)
GOTENBERG_URL=http://10.121.3.201:3004

# VLM defaults (перекрываются настройками из OpenWebUI)
DEFAULT_VLM_URL=http://10.121.3.201:4000/v1/chat/completions
DEFAULT_VLM_API_KEY=your_litellm_api_key_here
DEFAULT_VLM_MODEL=Qwen3.5-122B-agent-50k
DEFAULT_VLM_TIMEOUT=300
DEFAULT_VLM_CONCURRENCY=14
DEFAULT_VLM_MAX_CONCURRENT_DOCS=2
DEFAULT_VLM_MAX_COMPLETION_TOKENS=8192

# Роутинг между VLM (full-page OCR) и standard (текстовое извлечение + картинки)
TEXT_PDF_VLM_THRESHOLD=20           # TEXT PDF с кол-вом страниц > этого → standard pipeline

# Разрешение картинок
DEFAULT_VLM_SCALE=1.5               # VLM pipeline: scale для рендера страниц целиком (≈ 72 DPI)
DEFAULT_IMAGES_SCALE=2.0            # Standard pipeline: scale для встроенных картинок (≈ 96 DPI)

# Клиенты (OWUI) могут переопределить через form-params:
#   vlm_scale=X.X             — для VLM-ветки
#   images_scale=X.X          — для standard-ветки
#   vlm_page_threshold=N      — порог роутинга per-request
