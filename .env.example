# Docling-serve URL
DOCLING_URL=http://docling:5001/v1/convert/file

# Gotenberg (DOCX→PDF конвертация)
GOTENBERG_URL=http://10.121.3.201:3004

# VLM defaults (перекрываются настройками из OpenWebUI)
DEFAULT_VLM_URL=http://10.121.3.201:4000/v1/chat/completions
DEFAULT_VLM_API_KEY=your_litellm_api_key_here
DEFAULT_VLM_MODEL=Qwen3.5-122B-agent-50k
DEFAULT_VLM_TIMEOUT=300
DEFAULT_VLM_CONCURRENCY=14
DEFAULT_VLM_MAX_CONCURRENT_DOCS=2
DEFAULT_VLM_MAX_COMPLETION_TOKENS=8192

# Роутинг между VLM (full-page OCR) и standard (текстовое извлечение + картинки)
# Все три параметра можно переопределить per-request через form-data
# (payload OWUI). Приоритет: payload > .env > хардкод в коде.
TEXT_PDF_VLM_THRESHOLD=20           # TEXT PDF с кол-вом страниц <= этого → VLM, иначе → standard. 0 → всегда standard.
SCAN_PDF_FULL_PAGE=true             # SCAN PDF: true → VLM full-page, false → standard pipeline (docling сам OCR'ит).

# Разрешение картинок
DEFAULT_VLM_SCALE=1.5               # VLM pipeline: scale для рендера страниц целиком (≈ 72 DPI)
DEFAULT_IMAGES_SCALE=2.0            # Standard pipeline: scale для встроенных картинок (≈ 96 DPI)

# Клиенты (OWUI) могут переопределить через form-params:
#   vlm_scale=X.X                 — для VLM-ветки
#   images_scale=X.X              — для standard-ветки
#   vlm_page_threshold=N          — порог роутинга per-request (0 → TEXT никогда не в VLM)
#   scan_pdf_full_page=true|false — SCAN-маршрут per-request

# Описывать картинки через VLM в standard pipeline (не full-page VLM).
# При true каждая вырезанная картинка отправляется в picture_description_api,
# описание вставляется в итоговый markdown.
# При false markdown содержит только сами картинки без текстового описания.
ENRICH_PICTURES_WITH_122B=true

# ═══════════════════════════════════════════════════════════════
# VLM endpoint (proxy gateway: sampling injection + truncate analytics)
# ═══════════════════════════════════════════════════════════════
# При VLM_PROXY_ENABLED=true build_*() инжектируют в конфиги docling-serve
# url=VLM_PROXY_URL?profile=full_page|picture_desc, и docling-serve ходит
# через прокси, а тот добавляет sampling и системный промпт. Безопасный
# путь миграции: первый деплой с false → smoke-тест endpoint'а →
# переключение в true → рестарт. Откат — вернуть false и рестарт.
VLM_PROXY_ENABLED=false

# URL прокси (self-reference). Подставляется в конфиги docling-serve.
VLM_PROXY_URL=http://10.121.3.201:5005/v1/chat/completions

# Upstream (LiteLLM/SGLang). Если пусто — используются DEFAULT_VLM_URL/API_KEY.
VLM_UPSTREAM_URL=
VLM_UPSTREAM_API_KEY=

# ── Sampling profile FULL_PAGE (full-page OCR страницы документа) ──
# Профиль C из калибровки апреля 2026. 0 лупов на стресс-тесте 760
# одновременных запросов и 0.5–1% плато на разреженных ГОСТ-таблицах.
# Любой параметр можно отключить, оставив значение пустым — тогда
# upstream получит default из SGLang/LiteLLM.
VLM_FULL_PAGE_TEMPERATURE=1.0
VLM_FULL_PAGE_TOP_P=0.8
VLM_FULL_PAGE_TOP_K=40
VLM_FULL_PAGE_MIN_P=0.1
VLM_FULL_PAGE_PRESENCE_PENALTY=2.0
VLM_FULL_PAGE_REPETITION_PENALTY=1.0
VLM_FULL_PAGE_MAX_TOKENS=3072

# ── Sampling profile PICTURE_DESC (описание вырезанных регионов) ──
VLM_PICTURE_DESC_TEMPERATURE=0.7
VLM_PICTURE_DESC_TOP_P=0.8
VLM_PICTURE_DESC_TOP_K=20
VLM_PICTURE_DESC_PRESENCE_PENALTY=1.5
VLM_PICTURE_DESC_REPETITION_PENALTY=1.0
VLM_PICTURE_DESC_MAX_TOKENS=1024

# ── Промпты (опционально) ──
# Если файл существует — берётся он, иначе встроенный default из main.py
# (DEFAULT_VLM_FULL_PAGE_PROMPT / DEFAULT_VLM_PICTURE_DESC_PROMPT).
# Файлы в репо не коммитятся, создаются вручную при необходимости.
VLM_PROMPT_FULL_PAGE_FILE=/proxy/prompts/full_page.txt
VLM_PROMPT_PICTURE_DESC_FILE=/proxy/prompts/picture_desc.txt

# ── Аналитика VLM endpoint'а ──
# JSONL-лог запросов (по строке на запрос) с дневной ротацией:
# реальные файлы — vlm_requests_<DATE>.jsonl рядом с указанным.
VLM_REQUEST_LOG_FILE=/proxy/logs/vlm_requests.jsonl

# Каталог с детализацией truncate-кейсов (finish_reason=length).
# Структура: <DATE>/<request_id>/{request,response,meta}.json + page_*.png
VLM_TRUNCATE_LOG_DIR=/proxy/logs/truncated

# Сохранять ли в дамп исходные картинки и полный prompt (true) или
# только meta.json с метриками (false, компактный режим).
VLM_TRUNCATE_SAVE_PAYLOAD=true

# Сколько дней держать каталоги дампов до автоматического удаления.
VLM_TRUNCATE_RETENTION_DAYS=30

# ── Retention для остальных лог-файлов ──
# vlm_requests_*.jsonl — счётчики каждого запроса (1 строка/запрос),
# по дню на файл. Помимо retention есть страховочный размерный cap
# по сумме всех vlm_requests_*.jsonl в каталоге: при превышении
# удаляются самые старые до возврата под лимит, независимо от retention.
VLM_REQUEST_LOG_RETENTION_DAYS=90
VLM_REQUEST_LOG_MAX_SIZE_MB=5120

# null_response_*.json — диагностические дампы случаев, когда docling
# вернул null/empty md_content. Каждый — отдельный файл в LOG_DIR.
NULL_RESPONSE_LOG_RETENTION_DAYS=30

# error_response_*.json — диагностические дампы upstream-сбоев docling
# (httpx-исключения, 5xx). Каждый — отдельный файл в LOG_DIR.
ERROR_RESPONSE_LOG_RETENTION_DAYS=30
